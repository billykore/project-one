database:
  host: "localhost"
  port: 5432
  user: "postgres"
  password: "password"
  dbname: "postgres"
  sslmode: "disable"
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: "1h"
jwt:
  private_key_path: "./configs/keys/jwt-private.pem"
  public_key_path: "./configs/keys/jwt-public.pem"
  expiration_time: 24h
message_broker:
  type: "rabbitmq"
  kafka:
    brokers:
      - "localhost:9092"
    topic_prefix: "project1"
    consumer_group: "notification-consumer"
    tls_enabled: false
  rabbitmq:
    url: "amqp://guest:guest@localhost:5672/"
    exchange: "project1.notifications"
    queue: "notifications"
app:
  port: 8080
  env: "development"
  error_type_base_url: ""
feature_flags:
  environment: "local"
  refresh_interval: "30s"
  operators:
    - "operator1"
# Dedicated machine credentials for the Prometheus scrape of /metrics.
# Both keys must be set together, and the referenced secret file must exist and
# be non-empty, or startup fails. Leave both unset to reject every scrape.
# Create the local secret with:
#   mkdir -p deployments/observability/secrets
#   printf '%s' '<monitoring-password>' > deployments/observability/secrets/metrics-password
# monitoring:
#   username: "projectone-metrics"
#   password_file: "./deployments/observability/secrets/metrics-password"
